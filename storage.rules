rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function esAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    match /contenido/{tipo}/{archivo} {
      allow read: if true;
      allow create, update: if esAdmin() &&
        tipo in ['portadas', 'productos', 'promociones'] &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow delete: if esAdmin();
    }
  }
}
